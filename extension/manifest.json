{
  "manifest_version": 3,
  "name": "YouTube Super Lite + Aero",
  "version": "0.7.2",
  "description": "Same-origin low-memory YouTube player with inert Mix extraction, Cinema mode and Aero Mix capture.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "YouTube Super Lite",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["takeover-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["lite.js"],
      "css": ["lite.css"],
      "run_at": "document_start"
    }
  ]
}
