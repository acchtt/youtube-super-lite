{
  "manifest_version": 3,
  "name": "Aero Native + YouTube Super Lite",
  "version": "0.10.0",
  "description": "Aero-style first-party YouTube watch mode with native playback, history, and Mix support.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Aero Native",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "lite.js"
      ],
      "css": [
        "lite.css"
      ],
      "run_at": "document_start"
    }
  ]
}
