{
  "manifest_version": 3,
  "name": "Aero Mix Bridge",
  "version": "0.1.1",
  "description": "Captures the personalized YouTube Mix queue from youtube.com and sends it to Aero × IVE.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://aero-x-ive.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://aero-x-ive.pages.dev/*"],
      "js": ["aero.js"],
      "run_at": "document_start"
    }
  ]
}
