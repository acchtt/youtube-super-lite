name = "aero-x-ive"
pages_build_output_dir = "."
compatibility_date = "2026-09-22"

# After creating your D1 database, copy its ID here and rename this file
# to wrangler.toml if you prefer managing the binding through Wrangler.
[[d1_databases]]
binding = "DB"
database_name = "youtube-super-lite"
database_id = "REPLACE_WITH_D1_DATABASE_ID"


# Browser OAuth experiment. This is a Web OAuth client ID, not a client secret.
[vars]
GOOGLE_OAUTH_CLIENT_ID = "REPLACE_WITH_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com"
